        DOUBLE predicted_lst_upper_c
        VARCHAR model_version
        VARCHAR data_source_status
        DOUBLE latitude
        DOUBLE longitude
        BOOLEAN coordinates_verified
        TIMESTAMP created_at
    }
    ENVIRONMENTAL_RECOMMENDATIONS {
        CHAR recommendation_id PK
        VARCHAR zone_id
        VARCHAR zone_name
        VARCHAR environmental_issue
        VARCHAR issue_type
        JSON supporting_evidence
        TEXT recommended_intervention
        TEXT reason
        VARCHAR priority
        DOUBLE confidence
        TIMESTAMP recommendation_timestamp
        TEXT follow_up_measurement
        CHAR related_prediction_id FK
        CHAR deduplication_key UK
        VARCHAR source_status
    }
    ML_PREDICTIONS ||--o{ ENVIRONMENTAL_RECOMMENDATIONS : "optional related prediction"
