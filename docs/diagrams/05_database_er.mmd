        TIMESTAMP processed_at
    }
    ML_PREDICTIONS {
        CHAR prediction_id PK
        VARCHAR zone_id
        VARCHAR zone_name
        DATE input_observation_date
        DATE target_observation_date
        SMALLINT forecast_horizon_days
        DOUBLE predicted_lst_c
