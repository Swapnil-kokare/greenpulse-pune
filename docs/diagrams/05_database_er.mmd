    ZONE_ENVIRONMENT_SUMMARY {
        BIGINT id PK
        BIGINT batch_id
        VARCHAR zone_id
        VARCHAR zone_name
        INT records_received
        DOUBLE mean_lst_c
        DOUBLE mean_ndvi
        DATE latest_observation_date
        TIMESTAMP processed_at
    }
    ENVIRONMENT_OBSERVATIONS {
        BIGINT observation_id PK
        VARCHAR zone_id
        VARCHAR zone_name
        DATE observation_date
        DOUBLE lst_celsius
        DOUBLE ndvi
        DOUBLE ndbi
        DOUBLE latitude
        DOUBLE longitude
        BOOLEAN coordinates_verified
